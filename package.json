{
  "name": "braingl-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "brainGL's connectivity glyphs in the web browser (WebGL2): points, vectors, pies, difference and anatomical-background glyphs on cortical surfaces, with the Directionality workspace and Blender export.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node tests/e2e/smoke.mjs",
    "export:blender": "vite-node tools/export_blender.ts --",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "gl-matrix": "^3.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.40",
    "puppeteer-core": "^25.18.1",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.5.0"
  },
  "homepage": "https://neuroanatomyandconnectivity.github.io/braingl-web/",
  "repository": {
    "type": "git",
    "url": "https://github.com/NeuroanatomyAndConnectivity/braingl-web.git"
  },
  "bugs": {
    "url": "https://github.com/NeuroanatomyAndConnectivity/braingl-web/issues"
  }
}
